@using YkbYapikredi.Application.Blog
@model YkbYapikredi.Web.Models.BlogCardViewModel

@{
    var article = Model.Article;
    var color = Model.Category?.Color ?? "blue";
    // CoverImage "~/getmedia/..." biçiminde geliyor; Razor bunu düz string'de çözmez.    var imageUrl = string.IsNullOrWhiteSpace(article.ImageUrl) ? null : Url.Content(article.ImageUrl);
}
<li><a class="blog-card" href="@article.Url" style="--blog-card-color: var(--blog-@color)"><div class="blog-card__media">            @if (imageUrl is not null)
            {
                <img src="@imageUrl" alt="@article.Title" loading="lazy" />            }
            else            {
                <span class="blog-card__media--empty"></span>            }
        </div><div class="blog-card__body">            @if (Model.Category is not null)
            {
                <span class="blog-card__category">@Model.Category.Title</span>            }

            <h2 class="blog-card__title">@article.Title</h2>
            @if (!string.IsNullOrWhiteSpace(article.Summary))
            {
                <p class="blog-card__summary">@article.Summary</p>            }

            <div class="blog-card__meta"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 11h18" /></svg>                    @article.PublishDate.ToString("dd MMMM yyyy")
                </span>
                @if (article.ReadingMinutes > 0)
                {
                    <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>                        @article.ReadingMinutes dk
                    </span>                }
            </div></div></a></li>
 