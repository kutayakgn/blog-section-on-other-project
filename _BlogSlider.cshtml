@model YkbYapikredi.Web.Models.BlogPageViewModel

@if (Model.Latest.Count > 0)
{
    <section class="blog-slider"
             aria-label="Son yazılar"
             data-slider
             data-slider-autoplay-ms="5000">
        <button type="button"
                class="blog-slider__arrow blog-slider__arrow--prev"
                data-slider-prev
                aria-label="Önceki yazı"
                hidden>
            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
                <path d="M15 5l-7 7 7 7" />
            </svg>
        </button>

        <ul class="blog-slider__track" data-slider-track>
            @for (var index = 0; index < Model.Latest.Count; index++)
            {
                var article = Model.Latest[index];
                var category = Model.GetCategory(article);
                var color = category?.Color ?? "blue";
                var imageUrl = string.IsNullOrWhiteSpace(article.ImageUrl)
                    ? null
                    : Url.Content(article.ImageUrl);
                var isActive = index == 0;

                <li class="blog-slide @(isActive ? "is-active" : null)"
                    @(isActive ? "aria-current=true" : null)>
                    <a class="blog-slide__link"
                       href="@article.Url"
                       style="--blog-card-color: var(--blog-@color)">
                        @if (imageUrl is not null)
                        {
                            <img class="blog-slide__image"
                                 src="@imageUrl"
                                 alt="@article.Title"
                                 loading="@(index == 0 ? "eager" : "lazy")" />
                        }
                        <span class="blog-slide__shade" aria-hidden="true"></span>
                        <span class="blog-slide__body">
                            <span class="blog-slide__title">@article.Title</span>
                            <span class="blog-slide__footer">
                                <span class="blog-slide__meta">
                                    <span>
                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             aria-hidden="true">
                                            <rect x="3" y="5" width="18" height="16" rx="2" />
                                            <path d="M8 3v4M16 3v4M3 11h18" />
                                        </svg>
                                        @article.PublishDate.ToString("dd MMMM yyyy")
                                    </span>
                                    @if (article.ReadingMinutes > 0)
                                    {
                                        <span>
                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 aria-hidden="true">
                                                <circle cx="12" cy="12" r="9" />
                                                <path d="M12 7v5l3 2" />
                                            </svg>
                                            @article.ReadingMinutes dk
                                        </span>
                                    }
                                </span>
                                @if (category is not null)
                                {
                                    <span class="blog-slide__category">@category.Title</span>
                                }
                            </span>
                        </span>
                    </a>
                </li>
            }
        </ul>

        <button type="button"
                class="blog-slider__arrow blog-slider__arrow--next"
                data-slider-next
                aria-label="Sonraki yazı">
            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
                <path d="M9 5l7 7-7 7" />
            </svg>
        </button>

        @if (Model.Latest.Count > 1)
        {
            <ul class="blog-slider__dots"
                data-slider-dots
                aria-label="Slider sayfaları">
                @for (var index = 0; index < Model.Latest.Count; index++)
                {
                    var isActive = index == 0;
                    <li>
                        <button type="button"
                                class="blog-slider__dot @(isActive ? "is-active" : null)"
                                data-slider-dot
                                aria-label="@(index + 1). yazıya git"
                                aria-current="@(isActive ? "true" : null)"></button>
                    </li>
                }
            </ul>
        }
    </section>
}
