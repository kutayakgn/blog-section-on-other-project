@model YkbYapikredi.Web.Models.BlogArticleViewModel
@{
    var url = Uri.EscapeDataString(Model.AbsoluteUrl);
    var text = Uri.EscapeDataString(Model.Title);
}

<div class="blog-share" data-share data-share-url="@Model.AbsoluteUrl" data-share-title="@Model.Title">
    <span class="blog-share__toggle" tabindex="0" aria-label="Paylaşım seçeneklerini göster">
        <span class="icon-Share" aria-hidden="true"></span>
        Paylaş
    </span>

    <ul class="blog-share__list" aria-label="Paylaşım seçenekleri">
        <li>
            <a href="https://www.facebook.com/sharer/sharer.php?u=@url" data-share-popup="facebook" target="_blank" rel="noopener">
                <span class="icon-Facebook" aria-hidden="true"></span>
                Facebook'ta Paylaş
            </a>
        </li>
        <li>
            <a href="https://twitter.com/intent/tweet?url=@url&text=@text" data-share-popup="twitter" target="_blank" rel="noopener">
                <span class="icon-Twitter" aria-hidden="true"></span>
                Twitter'da Paylaş
            </a>
        </li>
        <li>
            <a href="https://api.whatsapp.com/send?text=@text%20@url" data-share-popup="whatsapp" target="_blank" rel="noopener">
                <span class="icon-Whatsapp" aria-hidden="true"></span>
                WhatsApp'ta Paylaş
            </a>
        </li>
        <li>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url=@url" data-share-popup="linkedin" target="_blank" rel="noopener">
                <span class="icon-Linkedin" aria-hidden="true"></span>
                LinkedIn'de Paylaş
            </a>
        </li>
        <li>
            <button type="button" data-share-copy>
                <span class="icon-Copy" aria-hidden="true"></span>
                Bağlantıyı Kopyala
            </button>
        </li>
    </ul>
</div>
