@using Microsoft.AspNetCore.Html
@model YkbYapikredi.Web.Models.BlogNavViewModel

<nav id="blog-navigation" class="blog-nav" aria-label="Blog kategorileri">
    <div class="blog-nav__inner">
        <button type="button"
                class="blog-nav__toggle"
                data-desktop-nav-toggle
                aria-expanded="true"
                aria-controls="blog-navigation"
                aria-label="Menüyü daralt">
            <span aria-hidden="true"></span>
        </button>

        <ul class="blog-nav__list">
            @for (var index = 0; index < Model.Items.Count; index++)
            {
                var item = Model.Items[index];
                var isActive = Model.IsActive(item);

                <li>
                    <a href="@item.Url"
                       class="blog-nav__link @(isActive ? "is-active" : null)"
                       style="--blog-nav-color: var(--blog-@item.Color)"
                       data-title="@item.Title"
                       aria-current="@(isActive ? "page" : null)">
                        <span class="blog-nav__icon">
                            @if (!string.IsNullOrWhiteSpace(item.IconCssClass))
                            {
                                <i class="@item.IconCssClass" aria-hidden="true"></i>
                            }
                        </span>
                        <span class="blog-nav__label">@item.Title</span>
                    </a>
                </li>
            }
        </ul>
    </div>
</nav>
